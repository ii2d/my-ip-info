{
  "name": "my-ip-info",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Multi-source IP intelligence and connectivity diagnostic suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/ii2d/my-ip-info.git"
  },
  "homepage": "https://ip.ii2d.com",
  "scripts": {
    "dev": "concurrently -k -n client,worker -c cyan,magenta \"pnpm dev:client\" \"pnpm dev:worker\"",
    "dev:client": "vite",
    "dev:worker": "wrangler dev",
    "dev:node": "tsx src/server/node.ts",
    "build": "vite build",
    "build:pages": "GITHUB_PAGES=true vite build",
    "deploy": "pnpm build && wrangler deploy",
    "secrets:push": "wrangler secret bulk .env",
    "undeploy": "wrangler delete",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pre-commit": "lint-staged",
    "prepare": "git config core.hooksPath .githooks",
    "audit": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level=high"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lint-staged": "^17.5.1",
    "terser": "^5.51.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.134.0"
  },
  "packageManager": "pnpm@12.3.4"
}
