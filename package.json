{
  "name": "my-ip-info-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source multi-source IP intelligence and connectivity diagnostic suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/ii2d/my-ip-info.git"
  },
  "homepage": "https://my-ip-info.ii2d.com",
  "bugs": {
    "url": "https://github.com/ii2d/my-ip-info/issues"
  },
  "scripts": {
    "dev": "pnpm --filter @my-ip/web dev",
    "dev:api": "pnpm --filter @my-ip/server-cloudflare dev",
    "dev:node": "pnpm --filter @my-ip/server-node dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "deploy": "node scripts/deploy.mjs",
    "deploy:api": "node scripts/deploy.mjs --api",
    "deploy:web": "node scripts/deploy.mjs --web",
    "destroy": "node scripts/destroy.mjs",
    "destroy:api": "node scripts/destroy.mjs --api",
    "destroy:web": "node scripts/destroy.mjs --web",
    "infra:preview": "pnpm --filter @my-ip/infra preview",
    "infra:up": "pnpm --filter @my-ip/infra up",
    "infra:destroy": "pnpm --filter @my-ip/infra destroy",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -r typecheck",
    "audit": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level=high"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.3.4"
}
