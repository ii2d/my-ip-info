{
  "name": "my-ip-info-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source multi-source IP intelligence and connectivity diagnostic suite",
  "scripts": {
    "dev": "pnpm --filter @my-ip/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "deploy:cloudflare": "pnpm --filter @my-ip/server-cloudflare deploy",
    "deploy:firebase": "pnpm --filter @my-ip/server-firebase deploy",
    "deploy:lambda": "node scripts/deploy-and-sync.mjs --lambda-only",
    "deploy:web": "node scripts/deploy-web.mjs",
    "deploy:all": "node scripts/deploy-and-sync.mjs",
    "destroy:cloudflare": "node scripts/destroy-and-sync.mjs --cloudflare-only",
    "destroy:firebase": "node scripts/destroy-and-sync.mjs --firebase-only",
    "destroy:lambda": "node scripts/destroy-and-sync.mjs --lambda-only",
    "destroy:web": "node scripts/destroy-and-sync.mjs --web-only",
    "destroy:all": "node scripts/destroy-and-sync.mjs",
    "destroy": "node scripts/destroy-and-sync.mjs",
    "sync:endpoints": "node scripts/deploy-and-sync.mjs --sync-only"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.8.0"
}
