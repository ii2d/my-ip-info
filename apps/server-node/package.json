  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@my-ip/core": "workspace:*",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
