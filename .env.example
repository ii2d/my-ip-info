# ==============================================================================
# my-ip-info Environment & Deployment Configuration
# Copy this file to .env or .env.local and adjust values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Workers (apps/server-cloudflare)
# ------------------------------------------------------------------------------
# Required when multiple Cloudflare accounts are linked to your login.
# Run `npx wrangler whoami` to list your account IDs.
CLOUDFLARE_ACCOUNT_ID=

# Custom name for your Cloudflare Worker (optional, defaults to my-ip-info)
CLOUDFLARE_WORKER_NAME=my-ip-info

# Optional custom domain for Cloudflare Worker API (e.g. api.yourdomain.com)
# CLOUDFLARE_WORKER_DOMAIN=

# ------------------------------------------------------------------------------
# 2. Cloudflare Pages (apps/web)
# ------------------------------------------------------------------------------
# Project name for Pages (defaults to my-ip-info)
CLOUDFLARE_PAGES_PROJECT_NAME=my-ip-info

# Optional custom domain for Web Dashboard (e.g. ip.yourdomain.com)
# CLOUDFLARE_PAGES_DOMAIN=

# ------------------------------------------------------------------------------
# 2. Firebase Functions (apps/server-firebase)
# ------------------------------------------------------------------------------
# Your Firebase Project ID (found in Firebase Console -> Project Settings)
FIREBASE_PROJECT=

# Optional: Firebase CI token if deploying without interactive browser login
# Generate with: `npx firebase-tools login:ci`
# FIREBASE_TOKEN=

# ------------------------------------------------------------------------------
# 3. AWS / Lambda (apps/server-lambda)
# ------------------------------------------------------------------------------
# AWS CLI profile or credentials
AWS_PROFILE=default
AWS_REGION=us-east-1
