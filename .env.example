# ==============================================================================
# my-ip-info Environment & Deployment Configuration
# Copy this file to .env or .env.local and adjust values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Account(s)
# ------------------------------------------------------------------------------
# Run `npx wrangler whoami` to list your account IDs.
#
# Option A: Shared Account ID (Worker and Pages in the same account)
CLOUDFLARE_ACCOUNT_ID=

# Option B: Separate Account IDs (Deploy Worker and Pages to different accounts)
# CLOUDFLARE_WORKER_ACCOUNT_ID=
# CLOUDFLARE_PAGES_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 2. Cloudflare Worker Backend (apps/server-cloudflare)
# ------------------------------------------------------------------------------
# Custom name for your Cloudflare Worker (optional, defaults to my-ip-info)
CLOUDFLARE_WORKER_NAME=my-ip-info

# Optional custom domain for Cloudflare Worker API (e.g. api.yourdomain.com)
# CLOUDFLARE_WORKER_DOMAIN=

# ------------------------------------------------------------------------------
# 3. Cloudflare Pages Frontend (apps/web)
# ------------------------------------------------------------------------------
# Project name for Pages (defaults to my-ip-info)
CLOUDFLARE_PAGES_PROJECT_NAME=my-ip-info

# Optional custom domain for Web Dashboard (e.g. ip.yourdomain.com)
# CLOUDFLARE_PAGES_DOMAIN=

# ------------------------------------------------------------------------------
# 4. Pulumi Infrastructure-as-Code (infra/)
# ------------------------------------------------------------------------------
# Cloudflare API Token with permissions:
#   - Zone:DNS:Edit
#   - Account:Cloudflare Pages:Edit
# CLOUDFLARE_API_TOKEN=

# Cloudflare Zone ID for apex domain hosting the custom domain
# Find this on your Cloudflare dashboard overview page for your domain
# CLOUDFLARE_ZONE_ID=

# Optional: Pulumi local state configuration (defaults to local file-based state)
# PULUMI_CONFIG_PASSPHRASE=
# PULUMI_BACKEND_URL=file://./.pulumi
