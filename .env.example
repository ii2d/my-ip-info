# ==============================================================================
# my-ip-info Environment Configuration
#
# ZERO MANDATORY VARIABLES:
# The unified Cloudflare Worker architecture requires NO environment variables
# to build or deploy. Running `pnpm deploy` uses standard Wrangler authentication.
# ==============================================================================

# ------------------------------------------------------------------------------
# Optional: Cloudflare Headless / CI/CD Deployment
# ------------------------------------------------------------------------------
# Only needed if deploying via CI/CD (e.g., GitHub Actions) without interactive `wrangler login`:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# Optional: Local Standalone Node Server (src/server/node.ts / Docker)
# ------------------------------------------------------------------------------
# PORT=3000

# ------------------------------------------------------------------------------
# Optional: IP2Location.io Geolocation API
# ------------------------------------------------------------------------------
# API key for IP2Location.io rich IP intelligence (https://www.ip2location.io)
# Note: Read automatically by `wrangler dev` locally. To set in your deployed production Worker without manual typing, run:
#   grep "^IP2_LOCATION_API_KEY=" .env | cut -d= -f2- | pnpm exec wrangler secret put IP2_LOCATION_API_KEY
# IP2_LOCATION_API_KEY=your_ip2location_api_key_here

# ------------------------------------------------------------------------------
# Optional: Frontend Feature Toggles
# ------------------------------------------------------------------------------
# Set to 'true' to enable the IP2Location provider in the frontend UI
# VITE_ENABLE_IP2LOCATION=true

# ------------------------------------------------------------------------------
# Optional: Frontend Decoupled Backend URL
# ------------------------------------------------------------------------------
# API URL for decoupled static hosting (e.g., GitHub Pages)
# VITE_BACKEND_URL=https://my-ip-info.ii2d-dev.workers.dev


